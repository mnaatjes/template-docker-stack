# ==============================================================================
# Environment Configuration Template: {{ stack_name }}
# Copy this file to .env and configure local values during development.
# In production, this file is rendered from Ansible Vault by homelab-ops.
# ==============================================================================

# Application Environment (prod, stage, dev)
APP_ENV=dev

# Service Port Bindings
SERVICE_HTTP_PORT={{ service_http_port }}

# Persistent Data Storage Path
# Local Development: points to relative workspace
# Production: Injected by Ansible as /opt/homelab/prod/data/{{ stack_name }}
DATA_DIR=./data

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

{% if stack_type == "orchestrated_stack" %}
# Upstream Pre-Built Image Coordinates (GHCR / Container Registry)
BACKEND_IMAGE={{ image_registry_namespace }}/{{ stack_name }}-api:latest
FRONTEND_IMAGE={{ image_registry_namespace }}/{{ stack_name }}-ui:latest

# Service Secrets (Injected via Ansible Vault in production)
API_SECRET_KEY=dev_secret_key_change_in_production
{% else %}
# Upstream Pre-Built Image Coordinates
APP_IMAGE={{ image_registry_namespace }}/{{ stack_name }}:latest
SERVICE_USER=admin
SERVICE_PASSWORD=example_dev_password_do_not_use_in_prod
{% endif %}
