---
# ==============================================================================
# Docker Compose Stack Specification: {{ stack_name }}
# Adheres to Homelab Systems Lifecycle (HSL) Container Deployment Standards
# ==============================================================================

{% if stack_type == "orchestrated_stack" %}
services:
  # Frontend SPA & Reverse Proxy Router
  frontend:
    image: ${FRONTEND_IMAGE:-{{ image_registry_namespace }}/{{ stack_name }}-ui:latest}
    container_name: {{ stack_name }}-frontend
    restart: unless-stopped
    ports:
      - "${SERVICE_HTTP_PORT:-{{ service_http_port }}}:80"
    volumes:
      - ./config/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      backend:
        condition: service_healthy
    networks:
      - {{ stack_name | replace('-', '_') }}_net
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 5s

  # Backend Application Service (Polyrepo pre-compiled image)
  backend:
    image: ${BACKEND_IMAGE:-{{ image_registry_namespace }}/{{ stack_name }}-api:latest}
    container_name: {{ stack_name }}-backend
    restart: unless-stopped
    environment:
      - APP_ENV=${APP_ENV:-dev}
      - LOG_LEVEL=${LOG_LEVEL:-info}
      - PORT=8000
    volumes:
      # Dynamic persistent runtime state mount (Mirrored under /opt/homelab/prod/data/{{ stack_name }}/)
      - "${DATA_DIR:-./data}:/app/data"
    networks:
      - {{ stack_name | replace('-', '_') }}_net
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8000/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  {{ stack_name | replace('-', '_') }}_net:
    driver: bridge
{%- else %}
services:
  app:
    image: ${APP_IMAGE:-caddy:2.8-alpine}
    container_name: {{ stack_name }}-app
    restart: unless-stopped
    ports:
      - "${SERVICE_HTTP_PORT:-{{ service_http_port }}}:80"
    environment:
      - APP_ENV=${APP_ENV:-dev}
      - LOG_LEVEL=${LOG_LEVEL:-info}
    volumes:
      # Read-only configuration template mount
      - ./config/sample.conf:/etc/sample.conf:ro
      # Dynamic persistent runtime state mount (Mirrored under /opt/homelab/prod/data/{{ stack_name }}/)
      - "${DATA_DIR:-./data}:/data"
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:80/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
{%- endif %}
